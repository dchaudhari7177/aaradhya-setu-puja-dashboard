# Copy to .env.local. Every variable is optional for local development:
# with nothing set, `npm run dev` starts a local MongoDB (data in .data/mongo)
# and seeds 72 demo bookings.

# --- Database selection -------------------------------------------------------
# mongodb | firestore | memory. Default: firestore if Firebase credentials are
# present, otherwise mongodb.
# DB_DRIVER=mongodb

# --- MongoDB (default) --------------------------------------------------------
# Atlas or any MongoDB 6+ connection string. Required in production.
# MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/
# MONGODB_DB=aaradhya_setu

# --- Firestore ----------------------------------------------------------------
# Either the whole service-account JSON (raw or base64) ...
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}
# ... or the three fields separately (keep the \n escapes in the key):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Behaviour ----------------------------------------------------------------
# Seed demo data when the database is empty (default true).
# SEED_ON_EMPTY=true
# Allow POST /api/demo/reset (default on). Set to "off" on a real deployment.
# DEMO_RESET=on
