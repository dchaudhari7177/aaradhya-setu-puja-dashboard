# Copy to .env.local. Every variable is optional for local development:
# with nothing set, `npm run dev` starts a local MongoDB (data in .data/mongo),
# seeds 72 demo bookings, and the dashboard needs no sign-in.

# --- Database selection -------------------------------------------------------
# firestore | mongodb | memory. Default: firestore when a Firebase service
# account is configured, otherwise mongodb.
# DB_DRIVER=firestore

# --- Firebase (Firestore database + Auth) ------------------------------------
# Server: a service-account key (Project settings -> Service accounts ->
# Generate new private key). Use ONE of these:
# FIREBASE_SERVICE_ACCOUNT_FILE=.secrets/service-account.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}
# FIREBASE_PROJECT_ID= / FIREBASE_CLIENT_EMAIL= / FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Browser: the web app config (public by design). Setting the API key turns on
# admin sign-in and makes every API route require a Firebase ID token.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Comma-separated admin emails. Strongly recommended: without it, any account in
# the Firebase project can use the API.
# ADMIN_EMAILS=ops@example.com,lead@example.com
# Optional sign-in extras:
# NEXT_PUBLIC_AUTH_GOOGLE=true                 # show "Continue with Google"
# NEXT_PUBLIC_DEMO_EMAIL= / NEXT_PUBLIC_DEMO_PASSWORD=   # "Fill in demo login" for reviewers

# --- MongoDB (alternative) ----------------------------------------------------
# MONGODB_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/
# MONGODB_DB=aaradhya_setu

# --- Behaviour ----------------------------------------------------------------
# SEED_ON_EMPTY=true    # seed demo data when the database is empty
# DEMO_RESET=on         # allow POST /api/demo/reset; set "off" for real data
