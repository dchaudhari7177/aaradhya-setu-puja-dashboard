rules_version = '2';

// All reads and writes go through the Next.js API, which uses the Admin SDK
// (Admin SDK access bypasses these rules). Browsers never talk to Firestore
// directly, so every client request is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
